# Google configuration
GOOGLE_JWT_REDEEM_URL=https://oauth2.googleapis.com/token
GOOGLE_EVENTS_URL=https://www.googleapis.com/calendar/v3/calendars/%s/events?maxResults=%d&singleEvents=True&orderBy=startTime&timeMin=%s&timeMax=%s
CALENDAR_UPDATE_FREQUENCY=600

# Weather configuration
WEATHER_API_CMD=curl -s 'https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s&hourly=temperature_2m,precipitation_probability,weather_code&timezone=%s&start_date=%s&end_date=%s'
WEATHER_UPDATE_FREQUENCY=3600

# Telemetry configuration
CURRENT_PATH=/sys/class/power_supply/max77696-battery/current_now
BATTERY_PATH=/sys/class/power_supply/max77696-battery/capacity
TELEM_DEVICE_ENDPOINT=http://127.0.0.1:8000/api/tailscale/devices
TELEM_SERVICE_ENDPOINT=http://127.0.0.1:8000/api/tailscale/services
TELEM_UPDATE_FREQUENCY=15
TELEM_NET_UPDATE_FREQUENCY=120

# Alert configuration
ALERT_ENDPOINT=http://127.0.0.1:8000/api/xmpp?max_events=3
ALERT_UPDATE_FREQUENCY=120

# Debugging
LOCAL_BUILD=true
LSAN_OPTIONS=suppressions=$(pwd)/lsan.supp:detect_leaks=1
