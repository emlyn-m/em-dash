# UI configuration (millis)
export UI_UPDATE_FREQUENCY=1000
export NET_UPDATE_FREQUENCY=5000

# Google configuration
export GOOGLE_JWT_REDEEM_URL="https://oauth2.googleapis.com/token"
export GOOGLE_EVENTS_URL="https://www.googleapis.com/calendar/v3/calendars/%s/events?maxResults=%d&singleEvents=True&orderBy=startTime&timeMin=%s&timeMax=%s"
export CALENDAR_UPDATE_FREQUENCY=3600

# Weather configuration
export WEATHER_API_CMD="curl -s 'https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s&hourly=temperature_2m,precipitation_probability,weather_code&timezone=%s&start_date=%s&end_date=%s'"
export WEATHER_UPDATE_FREQUENCY=3600

# Telemetry configuration
export CURRENT_PATH="/sys/class/power_supply/max77696-battery/current_now"
export BATTERY_PATH="/sys/class/power_supply/max77696-battery/capacity"
export TELEM_DEVICE_ENDPOINT="$API_URL/api/tailscale/devices"
export TELEM_SERVICE_ENDPOINT="$API_URL/api/tailscale/services"
export TELEM_UPDATE_FREQUENCY=1

# Alert configuration
export ALERT_ENDPOINT="$API_URL/api/xmpp?max_events=3"
export ALERT_UPDATE_FREQUENCY=900

# LED configuration
export LED_STRIP_ID="bf7224e9c1ddeef941lbte"
export LED_STRIP_NAME="device.led.strip0"
export LED_STRIP_IP="10.218.245.196"
export LED_STRIP_KEY=".wlW-^>|?rd^p|R9"
