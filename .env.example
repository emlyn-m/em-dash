# Copy to .env and fill in. KEY=value, no quotes, no `export`. The real .env is
# gitignored — never commit secrets.

# Google Calendar (service account)
GOOGLE_PRIVKEY=
GOOGLE_SERVICE_EMAIL=
GOOGLE_CALENDAR_ID=

# FindMy
FINDMY_EMAIL=
FINDMY_DEVICE_ID=
FINDMY_AAS=
FINDMY_FCM_ID=
FINDMY_FCM_TOKEN=

# Weather (open-meteo)
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_TIMEZONE=

# Telemetry / logging
LOG_IP=
LOG_PORT=
API_URL=

# LED strip (tuya)
LED_STRIP_ID=
LED_STRIP_NAME=
LED_STRIP_IP=
LED_STRIP_VERSION=
LED_STRIP_KEY=

# LED lamp (tuya)
LED_LAMP_ID=
LED_LAMP_NAME=
LED_LAMP_IP=
LED_LAMP_VERSION=
LED_LAMP_KEY=

# Update frequencies (seconds)
WEATHER_UPDATE_FREQUENCY=
